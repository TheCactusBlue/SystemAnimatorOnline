{
  "name": "system-animator-online",
  "version": "0.33.3",
  "description": "System Animator Online - 3D desktop mascot / VTuber app",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "setup-vendor": "node scripts/setup-vendor.mjs"
  },
  "nwjs": {
    "main": "SystemAnimator_webkit.html",
    "single-instance": false,
    "chromium-args": "--enable-webaudio-input --ignore-gpu-blacklist",
    "node-remote": "<local>",
    "window": {
      "frame": false,
      "toolbar": false,
      "resizable": false,
      "icon": "icon_teto_512x512.png",
      "transparent": true
    }
  },
  "dependencies": {
    "@huggingface/jinja": "^0.3.2",
    "@huggingface/transformers": "^3.4.2",
    "@mediapipe/face_mesh": "^0.4.1633559619",
    "@mediapipe/hands": "^0.4.1675469240",
    "@mediapipe/holistic": "0.5.1675471629",
    "@mediapipe/pose": "^0.5.1675469404",
    "@mediapipe/tasks-vision": "0.10.21",
    "@pixiv/three-vrm": "^3.4.1",
    "@pixiv/three-vrm-animation": "^3.4.1",
    "encoding-japanese": "2.0.0",
    "jsmediatags": "^3.9.7",
    "jszip": "^3.10.1",
    "nipplejs": "^0.10.2",
    "peerjs": "^1.5.4",
    "rbush": "^3.0.1",
    "three": "0.163.0"
  },
  "devDependencies": {
    "typescript": "^5.7.3",
    "vite": "^6.1.0"
  },
  "engines": {
    "node": ">=18"
  }
}
